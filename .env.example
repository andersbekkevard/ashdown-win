# Neon Postgres connection string. Required at runtime, not at build time.
# Vercel sets this automatically when the Neon integration is linked.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional, local development only: point the Neon HTTP driver at a local
# neon-http proxy in front of a plain Postgres, e.g. http://localhost:4444/sql.
# Leave unset in production.
# NEON_LOCAL_HTTP_ENDPOINT=
